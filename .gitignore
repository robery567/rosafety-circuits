# Manuscript — NEVER push any part of the manuscript to the public repo.
# Drafts, figures that appear in the paper, tables, bib, and build artifacts
# all live locally only. TACL is single-blind at submission but we keep the
# same no-leakage policy as Paper 2/3. Remove only if publication policy changes.
manuscript/

# LaTeX build artifacts (belt-and-braces; also covered by manuscript/)
*.aux
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.log
*.out
*.synctex.gz
*.toc
*.lot
*.lof

# LLM judge artefacts
experiments/.judge_cache/
experiments/judge_*.jsonl

# Private run journal — never push.
EXPERIMENT_LOG.md

# Cached activations + SAE tensors are large and Drive-only. Notebooks recreate
# data/ subdirs on first run (data/contrastive/<short>/, data/activations/<short>/,
# data/probes/<short>/, data/splits/). Public release copies the frozen
# contrastive sets, probe weights, SAE feature indices, and bands.json into the
# Zenodo deposit; nothing under data/ is tracked here. Same policy as Paper 3.
data/

# Local working files
*.swp
*.bak
*.tmp
